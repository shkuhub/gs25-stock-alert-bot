GS25_LAT=37.5665
GS25_LON=126.9780
GS25_RADIUS=500

# MVP test source: public GS25 relay
GS25_SOURCE=relay

# Safe default: 5 minutes
POLL_SECONDS=300

# Set to true only after the request path and limits have been verified.
ALLOW_HIGH_FREQUENCY_POLLING=false

# Threads - leave empty until the publishing stage
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
